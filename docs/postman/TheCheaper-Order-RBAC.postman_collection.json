{
  "info": {
    "name": "The Cheaper - Order RBAC",
    "description": "Manual API regression collection for Order RBAC, ownership and admin global scope.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userEmail", "value": "an.nguyen@gmail.com" },
    { "key": "userPassword", "value": "123456" },
    { "key": "user2Email", "value": "binh.tran@gmail.com" },
    { "key": "user2Password", "value": "123456" },
    { "key": "adminEmail", "value": "admin@gmail.com" },
    { "key": "adminPassword", "value": "123456" },
    { "key": "userToken", "value": "" },
    { "key": "user2Token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userOrderId", "value": "" },
    { "key": "user2OrderId", "value": "" },
    { "key": "anyOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "pm.environment.set('userToken', json.data.accessToken);"
            ] }
          }]
        },
        {
          "name": "Login User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{user2Email}}\",\n  \"password\": \"{{user2Password}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "pm.environment.set('user2Token', json.data.accessToken);"
            ] }
          }]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "pm.environment.set('adminToken', json.data.accessToken);"
            ] }
          }]
        }
      ]
    },
    {
      "name": "02 - User Order",
      "item": [
        {
          "name": "Create Order - User A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"paymentMethodId\": 1,\n  \"receiver\": \"Nguyễn Văn An\",\n  \"location\": \"Hà Nội\",\n  \"phone\": \"0901234567\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "if (json.data && json.data.id) pm.environment.set('userOrderId', String(json.data.id));"
            ] }
          }]
        },
        {
          "name": "Get My Orders - User A",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "orders"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Get Own Order - User A",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{userOrderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{userOrderId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Get Other User Order - IDOR",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{user2OrderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{user2OrderId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Cross-owner access is rejected', () => pm.expect(pm.response.code).to.be.oneOf([403, 404]));"
          ] } }]
        },
        {
          "name": "Cancel Own Order - User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{userOrderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{userOrderId}}", "cancel"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Cancel request is not unauthorized', () => pm.expect(pm.response.code).to.be.oneOf([200, 400, 501]));"
          ] } }]
        },
        {
          "name": "Cancel Other User Order - IDOR",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{user2OrderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{user2OrderId}}", "cancel"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Cross-owner cancel is rejected', () => pm.expect(pm.response.code).to.be.oneOf([403, 404]));"
          ] } }]
        }
      ]
    },
    {
      "name": "03 - Admin Order",
      "item": [
        {
          "name": "Get All Orders - Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "admin", "orders"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Get Any Order - Admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/orders/{{anyOrderId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "orders", "{{anyOrderId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('HTTP 200 for existing order', () => pm.response.to.have.status(200));"
          ] } }]
        },
        {
          "name": "Update Order Status - Admin",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PROCESSING\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/orders/{{anyOrderId}}/status", "host": ["{{baseUrl}}], "path": ["api", "admin", "orders", "{{anyOrderId}}", "status"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Admin update is authenticated/authorized', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"
          ] } }]
        }
      ]
    },
    {
      "name": "04 - Negative Security",
      "item": [
        {
          "name": "User Calls Admin List - MUST 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/orders?page=1&limit=10", "host": ["{{baseUrl}}], "path": ["api", "admin", "orders"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('User cannot use admin permission', () => pm.response.to.have.status(403));"
          ] } }]
        },
        {
          "name": "Anonymous Calls User List - MUST 401",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/orders?page=1&limit=10", "host": ["{{baseUrl}}], "path": ["api", "orders"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Anonymous request is rejected', () => pm.response.to.have.status(401));"
          ] } }]
        }
      ]
    }
  ]
}
