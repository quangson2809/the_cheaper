        ],
        "url": "{{baseUrl}}/api/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"paymentMethodId\":{{paymentMethodId}},\"receiver\":\"Phase 5\",\"location\":\"Test address\",\"phone\":\"0901234567\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('New unpaid COD order', () => { const d=pm.response.json().data; pm.expect(d.id).to.be.a('number'); pm.expect(d.status).to.eql('PENDING'); pm.expect(d.paymentMethodCode).to.eql('COD'); pm.expect(d.finalAmount).to.eql(200); pm.expect(d.items).to.have.length(1); });",
              "pm.collectionVariables.set('userAOrderId', String(pm.response.json().data.id));"
            ]
          }
        }
      ]
    },
