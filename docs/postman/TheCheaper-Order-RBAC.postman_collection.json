{
  "info": {
    "name": "The Cheaper - Order RBAC",
    "description": "Postman regression collection for Order RBAC and ownership.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},
    {"key":"userEmail","value":"an.nguyen@gmail.com"},
    {"key":"userPassword","value":"123456"},
    {"key":"user2Email","value":"binh.tran@gmail.com"},
    {"key":"user2Password","value":"123456"},
    {"key":"adminEmail","value":"admin@gmail.com"},
    {"key":"adminPassword","value":"123456"},
    {"key":"userToken","value":""},
    {"key":"user2Token","value":""},
    {"key":"adminToken","value":""},
    {"key":"userOrderId","value":""},
    {"key":"user2OrderId","value":""},
    {"key":"anyOrderId","value":""}
  ],
  "item": [
    {
      "name":"01 Auth",
      "item":[
        {"name":"Login User A","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"},"url":{"raw":"{{baseUrl}}/api/auth/login"}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json();","pm.expect(j.data.accessToken).to.be.a('string').and.not.empty;","pm.environment.set('userToken',j.data.accessToken);"]}}]},
        {"name":"Login User B","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{user2Email}}\",\n  \"password\": \"{{user2Password}}\"\n}"},"url":{"raw":"{{baseUrl}}/api/auth/login"}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json();","pm.expect(j.data.accessToken).to.be.a('string').and.not.empty;","pm.environment.set('user2Token',j.data.accessToken);"]}}]},
        {"name":"Login Admin","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},"url":{"raw":"{{baseUrl}}/api/auth/login"}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));","const j=pm.response.json();","pm.expect(j.data.accessToken).to.be.a('string').and.not.empty;","pm.environment.set('adminToken',j.data.accessToken);"]}}]}
      ]
    },
    {
      "name":"02 User Order",
      "item":[
        {"name":"Create Order - User A","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{userToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"paymentMethodId\": 1,\n  \"receiver\": \"Nguyễn Văn An\",\n  \"location\": \"Hà Nội\",\n  \"phone\": \"0901234567\"\n}"},"url":{"raw":"{{baseUrl}}/api/orders"}},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","const j=pm.response.json();","if(j.data?.id) pm.environment.set('userOrderId',String(j.data.id));"]}}]},
        {"name":"Get My Orders - User A","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":{"raw":"{{baseUrl}}/api/orders?page=1&limit=10"}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
        {"name":"Get Own Order - User A","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":{"raw":"{{baseUrl}}/api/orders/{{userOrderId}}"}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
        {"name":"Get Other User Order - IDOR","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":{"raw":"{{baseUrl}}/api/orders/{{user2OrderId}}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Cross-owner rejected',()=>pm.expect(pm.response.code).to.be.oneOf([403,404]));"]}}]},
        {"name":"Cancel Own Order - User A","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":{"raw":"{{baseUrl}}/api/orders/{{userOrderId}}/cancel"}},"event":[{"listen":"test","script":{"exec":["pm.test('Not authorization failure',()=>pm.expect(pm.response.code).to.be.oneOf([200,400,501]));"]}}]},
        {"name":"Cancel Other User Order - IDOR","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":{"raw":"{{baseUrl}}/api/orders/{{user2OrderId}}/cancel"}},"event":[{"listen":"test","script":{"exec":["pm.test('Cross-owner rejected',()=>pm.expect(pm.response.code).to.be.oneOf([403,404]));"]}}]}
      ]
    },
    {
      "name":"03 Admin Order",
      "item":[
        {"name":"Get All Orders - Admin","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":{"raw":"{{baseUrl}}/api/admin/orders?page=1&limit=10"}},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
        {"name":"Get Any Order - Admin","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":{"raw":"{{baseUrl}}/api/admin/orders/{{anyOrderId}}"}},"event":[{"listen":"test","script":{"exec":["pm.test('200 for existing order',()=>pm.response.to.have.status(200));"]}}]},
        {"name":"Update Order Status - Admin","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"PROCESSING\"\n}"},"url":{"raw":"{{baseUrl}}/api/admin/orders/{{anyOrderId}}/status"}},"event":[{"listen":"test","script":{"exec":["pm.test('Authorized',()=>pm.expect(pm.response.code).to.be.oneOf([200,400]));"]}}]}
      ]
    },
    {
      "name":"04 Negative Security",
      "item":[
        {"name":"User Calls Admin List - MUST 403","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{userToken}}"}],"url":{"raw":"{{baseUrl}}/api/admin/orders?page=1&limit=10"}},"event":[{"listen":"test","script":{"exec":["pm.test('403',()=>pm.response.to.have.status(403));"]}}]},
        {"name":"Anonymous Calls User List - MUST 401","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/orders?page=1&limit=10"}},"event":[{"listen":"test","script":{"exec":["pm.test('401',()=>pm.response.to.have.status(401));"]}}]}
      ]
    }
  ]
}
